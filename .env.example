# Copy to .env.local for local development, and set the same names in
# Netlify → Site configuration → Environment variables for production.
# All of these are optional.

# Canonical production URL (no trailing slash). On Netlify this falls back to
# the site's own URL (custom domain if set), so you usually don't need it.
# NEXT_PUBLIC_SITE_URL=https://skanis.example

# Search engines only get to index the production deploy (Netlify sets
# CONTEXT=production). Set this to "true" to force indexing on another host.
# SITE_INDEXING=true

# App Store / Google Play listing URLs. Until they are set, the store buttons
# on the site show as "Netrukus" (coming soon) placeholders.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Public contact address. Leave empty until a real inbox exists: the footer
# then points visitors to the signup form instead of showing an e-mail.
NEXT_PUBLIC_CONTACT_EMAIL=

# Legal details shown on /privatumo-politika and /naudojimo-salygos.
# Anything left empty is rendered as a highlighted placeholder that must be
# filled in before launch.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_CODE=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_PRIVACY_EMAIL=
